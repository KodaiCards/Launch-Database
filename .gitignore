# Node / npm
node_modules/
npm-debug.log*

# Environment / secrets — never commit
.env
.env.local
.env.*.local

# Local uploads (Railway uses /data/uploads via volume; local dev keeps them here)
uploads/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Word lockfiles + Word exports of repo docs (owner sometimes opens
# PROJECT_NORTH_STAR.md / README.md in Word; the .docx exports and
# ~$*.md/~$*.docx lockfiles are local-only artifacts).
~$*
*.docx

# Claude Code session/worktree state — local-only, never goes to GitHub.
# Exception: .claude/agents/ holds team-shared subagent personas that are
# intentionally version-controlled so every developer + CI run sees the
# same orchestration definitions. `.claude/*` (no trailing slash) lets
# us re-include specific subpaths; `.claude/` would not.
.claude/*
!.claude/agents/
!.claude/agents/**
package-lock.json
# desktop/package-lock.json is REQUIRED — GH Actions caches against it
# and npm ci needs it for reproducible installs. Un-ignore explicitly.
!desktop/package-lock.json
# osp-training/package-lock.json is REQUIRED — `npm run build:osp` runs
# `npm ci`, which needs a committed lockfile to install from. Un-ignore.
!osp-training/package-lock.json

# Playwright artifacts — regenerated each `npm run test:browser` run.
playwright-report/
test-results/

# OSP Design Training sub-project — built at deploy time by Railway, not committed
osp-training/node_modules/
osp-training/dist/

# Launch Fiber Desktop Electron app — built locally, not committed
desktop/node_modules/
desktop/dist/
desktop/out/
tests/integration/client_portal_e2e.test.js
tests/integration/project_photos_integration.test.js
