# Node / npm
node_modules/
npm-debug.log*

# Environment / secrets — never commit
.env
.env.local
.env.*.local

# Local uploads (Railway uses /data/uploads via volume; local dev keeps them here)
uploads/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Word lockfiles + Word exports of repo docs (owner sometimes opens
# PROJECT_NORTH_STAR.md / README.md in Word; the .docx exports and
# ~$*.md/~$*.docx lockfiles are local-only artifacts).
~$*
*.docx

# Claude Code session/worktree state — local-only, never goes to GitHub.
# Exception: .claude/agents/ holds team-shared subagent personas that are
# intentionally version-controlled so every developer + CI run sees the
# same orchestration definitions. `.claude/*` (no trailing slash) lets
# us re-include specific subpaths; `.claude/` would not.
.claude/*
!.claude/agents/
!.claude/agents/**
package-lock.json

# Playwright artifacts — regenerated each `npm run test:browser` run.
playwright-report/
test-results/
