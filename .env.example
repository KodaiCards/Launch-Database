# Copy this to .env and fill in your values

# PostgreSQL — Railway provides this automatically
DATABASE_URL=postgresql://user:password@host:port/dbname

# Anthropic API key — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Environment
NODE_ENV=production

# Port — Railway sets this automatically
PORT=3000

# File upload directory (Railway volume mount path)
UPLOAD_DIR=/data/uploads

# Desktop installer storage directory (Railway volume mount path).
# Holds .exe / .dmg / .deb / .AppImage installers uploaded via the admin UI
# (Admin → Installers). Defaults to <repo>/public/downloads/installers when
# unset, but installers are NOT checked into git — point this at a persistent
# volume mount in production so uploads survive container restarts.
INSTALLERS_DIR=/data/installers

# PostgreSQL connection pool maximum. Default is 20, which is safe for Railway
# shared-plan Postgres (max_connections ≈ 20-25). Raise only after confirming
# your Railway Postgres plan's actual max_connections via:
#   SELECT current_setting('max_connections');
PG_POOL_MAX=20

