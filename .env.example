# Copy this to .env and fill in your values

# PostgreSQL — Railway provides this automatically
DATABASE_URL=postgresql://user:password@host:port/dbname

# Anthropic API key — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Environment
NODE_ENV=production

# Port — Railway sets this automatically
PORT=3000

# File upload directory (Railway volume mount path)
UPLOAD_DIR=/data/uploads

# PostgreSQL connection pool maximum. Default is 20, which is safe for Railway
# shared-plan Postgres (max_connections ≈ 20-25). Raise only after confirming
# your Railway Postgres plan's actual max_connections via:
#   SELECT current_setting('max_connections');
PG_POOL_MAX=20

# ─── OAuth2 SSO Bridge (Moodle auth_oauth2 plugin) ───────────────────────────
# Required when Moodle SSO is active. All three must be set on the
# launch-database Railway service. The same CLIENT_ID and CLIENT_SECRET
# are pasted into Moodle's OAuth2 Issuer configuration screen.

# A stable, non-secret identifier for the Moodle OAuth2 client.
# Any short alphanumeric string works — e.g. "launch-fiber-moodle".
OAUTH2_CLIENT_ID=launch-fiber-moodle

# A strong random secret shared between launch-database and Moodle.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set this in Railway → Variables (secret) on the launch-database service.
# Paste the same value into Moodle: Site admin → Plugins → OAuth2 → Issuer → Client secret.
OAUTH2_CLIENT_SECRET=replace-with-strong-random-secret

# Comma-separated list of redirect URIs that Moodle is allowed to send users
# back to after the authorization code is issued. Must exactly match what
# Moodle sends in the redirect_uri query parameter.
# Typically: https://training.launchfiber.com/admin/oauth2callback.php
OAUTH2_ALLOWED_REDIRECT_URIS=https://training.launchfiber.com/admin/oauth2callback.php

# Optional: separate JWT secret for moodle-sso audience tokens.
# If unset, falls back to JWT_SECRET (the main session secret). Setting
# a separate value isolates Moodle tokens from session tokens — recommended
# for production once Moodle is live.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# OAUTH2_JWT_SECRET=replace-with-separate-strong-random-secret

# ─── Training tile URL ────────────────────────────────────────────────────────
# Controls where the "OSP Training" launcher tile sends users.
# Default (unset): /training/   → bundled Vite SPA already in repo.
# After Moodle goes live: set to your Moodle subdomain.
#   TRAINING_URL=https://training.launchfiber.com

# ─── Moodle startup hook (set on launch-database service) ────────────────────
# Used by moodle/scripts/startup-hook.sh to auto-configure the OAuth2
# issuer endpoints. Set this on the launch-database service so the hook
# knows where to point Moodle's auth_oauth2 plugin.
# Example: https://launch.launchfiber.com  (your launch-database public URL)
# LAUNCH_DB_BASE_URL=https://launch.launchfiber.com
