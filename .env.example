# Copy this to .env and fill in your values

# PostgreSQL — Railway provides this automatically
DATABASE_URL=postgresql://user:password@host:port/dbname

# Anthropic API key — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Environment
NODE_ENV=production

# Port — Railway sets this automatically
PORT=3000

# File upload directory (Railway volume mount path)
UPLOAD_DIR=/data/uploads

# Desktop installer storage directory (Railway volume mount path).
# Holds .exe / .dmg / .deb / .AppImage installers uploaded via the admin UI
# (Admin → Installers). Defaults to <repo>/public/downloads/installers when
# unset, but installers are NOT checked into git — point this at a persistent
# volume mount in production so uploads survive container restarts.
# In production we prefer GITHUB_REPO below — INSTALLERS_DIR is the fallback.
INSTALLERS_DIR=/data/uploads/installers

# RECOMMENDED PRODUCTION DOWNLOADS SOURCE (W240):
# When GITHUB_REPO is set, /api/downloads/manifest fetches the latest GitHub
# Release's .exe asset instead of scanning INSTALLERS_DIR. The .github/workflows/
# desktop-build.yml workflow auto-builds the proper Windows NSIS installer on a
# Windows runner + publishes it as a Release on every push to desktop/. The
# Downloads page then serves the freshest build with zero manual upload steps.
# Format: "owner/repo" (no https:// prefix).
GITHUB_REPO=kodaicards/launch-database

# Optional. Only needed if the GitHub repo is private. A fine-grained PAT with
# "Contents: read" permission is sufficient. Public repos work without a token.
# GITHUB_TOKEN=

# PostgreSQL connection pool maximum. Default is 20, which is safe for Railway
# shared-plan Postgres (max_connections ≈ 20-25). Raise only after confirming
# your Railway Postgres plan's actual max_connections via:
#   SELECT current_setting('max_connections');
PG_POOL_MAX=20

