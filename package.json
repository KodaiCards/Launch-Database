{
  "name": "launch-fiber-services",
  "version": "1.1.0",
  "description": "Launch Fiber Services - Project Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "prestart": "node scripts/auto_migrate.js",
    "migrate": "node scripts/run_migrations.js",
    "dev": "nodemon server.js",
    "test": "node --test --test-concurrency=1 --test-timeout=180000 tests/*.test.js",
    "test:browser": "playwright test",
    "build:osp": "cd osp-training && npm ci && npm run build && cp -r dist/. ../public/training/",
    "schema:sync": "node scripts/sync_schema.js",
    "premerge": "node scripts/premerge.js",
    "premerge:lint": "node scripts/premerge_lint.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@tmcw/togeojson": "^7.0.0",
    "adm-zip": "^0.5.14",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "dxf-parser": "^1.1.2",
    "express": "^4.19.2",
    "jsdom": "^24.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.11.5",
    "proj4": "^2.11.0",
    "puppeteer": "^23.0.0",
    "qrcode": "^1.5.4",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.15.0"
  }
}
