{
  "name": "launch-fiber-desktop",
  "version": "0.1.0",
  "description": "Launch Fiber Desktop — file sync + workspace for OSP engineering ops",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win --x64",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.launchfiber.desktop",
    "productName": "Launch Fiber Desktop",
    "win": {
      "target": "nsis",
      "icon": "renderer/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-store": "^10.0.0",
    "chokidar": "^4.0.0",
    "form-data": "^4.0.0",
    "node-fetch": "^2.7.0"
  }
}
